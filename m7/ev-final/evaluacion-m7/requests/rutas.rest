@baseUrl = http://localhost:3000
@apiUrl = {{baseUrl}}/api/v1

### =====================================================
### RUTA PRINCIPAL
### =====================================================

GET {{baseUrl}}

### =====================================================
### FRONTEND
### =====================================================

GET {{baseUrl}}/app

### =====================================================
### ESTADO DE LA BASE DE DATOS
### =====================================================

GET {{baseUrl}}/health

### =====================================================
### LISTAR PRIMEROS 5 PAÍSES
### =====================================================

GET {{apiUrl}}/paises?limite=5

### =====================================================
### LISTAR PRIMEROS 10 PAÍSES
### =====================================================

GET {{apiUrl}}/paises?limite=10

### =====================================================
### SIGUIENTE BLOQUE MEDIANTE CURSOR
### Reemplace Chile por el cursor recibido
### =====================================================

GET {{apiUrl}}/paises?limite=5&cursor=Chile

### =====================================================
### AGREGAR PAÍS
### =====================================================

POST {{apiUrl}}/paises
Content-Type: application/json

{
  "nombre": "Costa Rica",
  "continente": "América Central",
  "poblacion": 5180829,
  "pib2019": 64418,
  "pib2020": 62395
}

### =====================================================
### AGREGAR PAÍS REPETIDO
### Debe responder 409
### =====================================================

POST {{apiUrl}}/paises
Content-Type: application/json

{
  "nombre": "Chile",
  "continente": "América del Sur",
  "poblacion": 19120000,
  "pib2019": 278584,
  "pib2020": 252727
}

### =====================================================
### ELIMINAR PAÍS
### =====================================================

DELETE {{apiUrl}}/paises/Costa%20Rica

### =====================================================
### ELIMINAR PAÍS INEXISTENTE
### Debe responder 404
### =====================================================

DELETE {{apiUrl}}/paises/Pais%20Inexistente

### =====================================================
### RUTA INEXISTENTE
### =====================================================

GET {{baseUrl}}/ruta-inexistente